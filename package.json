{
	"name": "biliksewa",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
		"screenshot": "tsx scripts/screenshot.ts",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"check:worker": "tsc -p worker/tsconfig.json",
		"demo:build": "BILIKSEWA_TARGET=cloudflare-demo DATABASE_URL=durable-object vite build",
		"demo:dev": "npm run demo:build && wrangler dev -c wrangler.demo.jsonc",
		"demo:deploy": "npm run demo:build && wrangler deploy -c wrangler.demo.jsonc"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261125.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-cloudflare": "^9.0.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.5",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"wrangler": "^4.168.0"
	},
	"dependencies": {
		"better-sqlite3": "^13.2.0"
	},
	"allowScripts": {
		"better-sqlite3@13.2.0": false,
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true,
		"workerd@1.20261117.1": false,
		"workerd@1.20261123.1": false
	},
	"description": "Room and bed rental management for Malaysian landlords: beds, tenancies, pro-rated rent, bill splitting by nights stayed, tenant ledgers.",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	}
}
